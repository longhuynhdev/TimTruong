@startuml
left to right direction
skinparam packageStyle rectangle

actor "Học Sinh / Student" as Student

rectangle "Hệ Thống Tìm Trường (TimTruong)" {

  ' --- Implemented ---
  usecase "Tìm trường\ntheo điểm" as UC1
  usecase "Xem danh sách\ntrường" as UC2
  usecase "Xem danh sách\ntổ hợp môn" as UC3

  ' --- Planned ---
  usecase "Tìm trường\ntheo tên" as UC4
  usecase "Xem chi tiết trường" as UC5
  usecase "Xem danh sách ngành\nvà điểm chuẩn" as UC6
  usecase "Xem đề án\ntuyển sinh trường" as UC7
  usecase "Tư vấn ngành học" as UC8

}

' --- Relationships ---

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC8

UC6 .> UC5 : <<extends>>
UC7 .> UC5 : <<extends>>
@enduml
